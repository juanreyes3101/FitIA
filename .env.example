# Copiar como backend/.env y llenar. NUNCA subir el .env a GitHub.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitia
DB_USER=fitia_app
DB_PASSWORD=cambia_esto

# --- Seguridad ---
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# 5173 = web, 8081 = vista web de Expo, 5174 y app://fitia = FitIA Control (escritorio)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:5174,app://fitia

# --- IA ---  gemini | mock      COSTO $0 EN AMBOS CASOS
#  mock   = rutina armada por reglas, sin internet (usar mientras desarrollan)
#  gemini = IA real con la capa GRATUITA de Google AI Studio
AI_PROVIDER=mock
# Crear la llave en https://aistudio.google.com/apikey  (cuenta Google, SIN tarjeta).
# NO activar facturación ("billing") en Google Cloud: así es imposible que cobren.
GEMINI_API_KEY=
# Usar el modelo "Flash" o "Flash-Lite" que AI Studio marque como gratuito
GEMINI_MODEL=gemini-flash-latest
# Límite propio para no pasarse de la cuota gratis
IA_MAX_SOLICITUDES_DIA=200

# --- Monitoreo ---
# Para la demo en clase conviene MONITOR_INTERVAL_SEG=15
MONITOR_INTERVAL_SEG=60
MONITOR_VENTANA_MIN=30
MONITOR_Z_UMBRAL=3
MONITOR_ERROR_UMBRAL=0.05
MONITOR_ENFRIAMIENTO_SEG=300

# --- Clientes (en apps/*/.env) ---
# VITE_API_URL=http://localhost:5000/api/v1
# EXPO_PUBLIC_API_URL=http://<IP-de-tu-PC>:5000/api/v1
