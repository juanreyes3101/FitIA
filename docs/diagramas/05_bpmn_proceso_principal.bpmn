<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FitIA" targetNamespace="https://fitia.co/bpmn">
<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="FitIA — Generación y seguimiento de rutina personalizada" processRef="Proc"/></bpmn:collaboration>
<bpmn:process id="Proc" isExecutable="false"><bpmn:laneSet id="LS">
<bpmn:lane id="L_U" name="Usuario"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_A" name="App web / móvil"><bpmn:flowNodeRef>TP</bpmn:flowNodeRef><bpmn:flowNodeRef>EP</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_B" name="Backend FitIA (Flask + MySQL)"><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_I" name="Servicio de IA"><bpmn:flowNodeRef>T5</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Usuario quiere entrenar"><bpmn:outgoing>F0</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="T1" name="Registrarse o iniciar sesión"><bpmn:incoming>F0</bpmn:incoming><bpmn:outgoing>F1</bpmn:outgoing></bpmn:task>
<bpmn:task id="T2" name="Ingresar peso, estatura, actividad y molestias"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
<bpmn:task id="T3" name="Calcular IMC y asignar condiciones"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G1" name="¿Tiene cupo de IA?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="TP" name="Mostrar planes Pro (pago simulado)"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="EP" name="Sin rutina nueva"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T4" name="Obtener catálogo de ejercicios seguros"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
<bpmn:task id="T5" name="Generar rutina en JSON"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
<bpmn:task id="T6" name="Validar seguridad de la rutina"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G2" name="¿Rutina segura?"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T7" name="Guardar rutina (transacción)"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:task>
<bpmn:task id="T8" name="Mostrar rutina día a día"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
<bpmn:task id="T9" name="Entrenar y registrar sesión (RPE, dolor)"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task>
<bpmn:task id="T10" name="Actualizar progreso y adherencia"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G3" name="¿Dolor reportado &gt; 5?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T11" name="Cambiar a movilidad lumbar y avisar al entrenador"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E1" name="Rutina ajustada"><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="E2" name="Progreso actualizado"><bpmn:incoming>F18</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F0" sourceRef="S1" targetRef="T1"/>
<bpmn:sequenceFlow id="F1" sourceRef="T1" targetRef="T2"/>
<bpmn:sequenceFlow id="F2" sourceRef="T2" targetRef="T3"/>
<bpmn:sequenceFlow id="F3" sourceRef="T3" targetRef="G1"/>
<bpmn:sequenceFlow id="F4" name="No" sourceRef="G1" targetRef="TP"/>
<bpmn:sequenceFlow id="F5" sourceRef="TP" targetRef="EP"/>
<bpmn:sequenceFlow id="F6" name="Sí" sourceRef="G1" targetRef="T4"/>
<bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="T5"/>
<bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="T6"/>
<bpmn:sequenceFlow id="F9" sourceRef="T6" targetRef="G2"/>
<bpmn:sequenceFlow id="F10" name="No (reintentar)" sourceRef="G2" targetRef="T5"/>
<bpmn:sequenceFlow id="F11" name="Sí" sourceRef="G2" targetRef="T7"/>
<bpmn:sequenceFlow id="F12" sourceRef="T7" targetRef="T8"/>
<bpmn:sequenceFlow id="F13" sourceRef="T8" targetRef="T9"/>
<bpmn:sequenceFlow id="F14" sourceRef="T9" targetRef="T10"/>
<bpmn:sequenceFlow id="F15" sourceRef="T10" targetRef="G3"/>
<bpmn:sequenceFlow id="F16" name="Sí" sourceRef="G3" targetRef="T11"/>
<bpmn:sequenceFlow id="F17" sourceRef="T11" targetRef="E1"/>
<bpmn:sequenceFlow id="F18" name="No" sourceRef="G3" targetRef="E2"/>
</bpmn:process>
